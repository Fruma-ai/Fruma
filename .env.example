# Variable names only. Set values in Vercel or .env.local. Never commit secrets.
FRUMA_PASS_OWEN=
FRUMA_PASS_CHRIS=
FRUMA_PASS_SAM=
FRUMA_DEMO_PASSWORD=
OPEN_SUPPLY_HUB_TOKEN=

# Test spine persistence. Without DATABASE_URL the file store is used.
# FRUMA_DATA_DIR defaults to .data/fruma-test (gitignored).
FRUMA_DATA_DIR=
# Optional Postgres for the same spine shapes (header maps, deposits, confirmations, product truth).
DATABASE_URL=
