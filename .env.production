# Staging engine parameters. Replace the bracketed DATABASE_URL parts before boot.
# Never commit a filled password. postgres.js treats sslmode=require as TLS.
# Port 6543 is the transaction-mode pool. The client opens that pool with prepare disabled
# and pins search_path to fruma_production for the production surface.
DATABASE_URL="postgresql://fruma:<PASSWORD>@<HOST>:6543/fruma?sslmode=require"
NODE_ENV=production
FRUMA_PERSIST_SURFACE=production
